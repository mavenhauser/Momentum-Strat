# Copy this file to .env and fill in real values. .env is gitignored.

# IBKR TWS/Gateway socket connection
# Paper TWS default port: 7497 | Paper IB Gateway default port: 4002
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# Telegram bot (for signal/trade notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Polygon.io fallback for historical options data
POLYGON_API_KEY=

# Tastytrade (OAuth - recommended for unattended scripts; personal-account
# username/password sessions commonly hit 2FA and are not suitable here).
# Requires a one-time manual OAuth grant in Tastytrade's developer portal
# to mint TT_REFRESH_TOKEN.
TT_CLIENT_ID=
TT_CLIENT_SECRET=
TT_REFRESH_TOKEN=
