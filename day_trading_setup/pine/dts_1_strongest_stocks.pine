//@version=6
// Day Trading Setup 1/3 - Strongest Stocks screener.
//
// Table of up to 20 tickers: price, day volume, % change and where price sits
// versus PDH / PDL (prior regular-session high/low) and PMH / PML (premarket
// high/low), with a trend column: ▲ above PDH + PMH, ▼ below PDL + PML,
// ⚠ in between. Sorted strongest first. Alerts when a ticker flips ▲ / ▼.
//
// The ticker list is dynamic: pick a preset or paste any comma-separated list
// into the settings box (no code edits). Uses Pine v6 dynamic requests - one
// request per ticker, inside a loop.
//
// Part of day_trading_setup/ (see ../README.md). Use alongside
// 2/3 Trend & Breakouts and 3/3 Entry Signals.
indicator("DTS Screener", shorttitle = "DTS Screener", overlay = true)

// Max tickers scanned. TradingView allows 40 distinct requests per script, so
// this can be raised to 40 (also raise the table row count below).
MAX_T = 20

G_SYM = "Tickers"
preset = input.string("Custom list", "Ticker list", options = ["Custom list", "Momentum universe", "Mega-cap tech", "Semiconductors", "High beta / momentum", "Index ETFs + sectors"], group = G_SYM, tooltip = "Pick a preset, or choose 'Custom list' and edit the box below.", display = display.none)
custom = input.text_area("NVDA, AMD, AVGO, MU, DELL, TSLA, PLTR, MSFT, AAPL, GOOGL, META, AMZN, NFLX, ORCL, CRM, QCOM, INTC, ADBE, SPY, QQQ", "Custom list (comma-separated, up to 20)", group = G_SYM, tooltip = "Any symbols, separated by commas, spaces or new lines. Add an exchange prefix (e.g. NYSE:DELL) only if a ticker is ambiguous. Duplicates are ignored; anything past 20 is dropped.", display = display.none)

G_SCR = "Screener"
scrPos    = input.string("Top right", "Position", options = ["Top left", "Top right", "Bottom left", "Bottom right"], group = G_SCR, display = display.none)
txtSize   = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal"], group = G_SCR, display = display.none)
scrRows   = input.int(20, "Rows to show", minval = 1, maxval = 20, group = G_SCR, display = display.none)
scrSort   = input.string("Strength", "Sort by", options = ["Strength", "% change", "Input order"], group = G_SCR, tooltip = "Strength = trend column first (above PDH+PMH, then mixed, then below PDL+PML), then % change.", display = display.none)
scrTf     = input.timeframe("", "Timeframe (blank = chart)", group = G_SCR, tooltip = "Must be intraday. Set to 5 to speed up loading on a 1-minute chart.", display = display.none)
scrAlerts = input.bool(true, "alert() when a ticker flips to ▲ / ▼", group = G_SCR, display = display.none)

C_BULL = #00E676
C_BEAR = #FF1744
C_WARN = #FFC107
C_DIM  = #787B86
C_SEL  = #2962FF

f_pos(string s) =>
    switch s
        "Top left"    => position.top_left
        "Top right"   => position.top_right
        "Bottom left" => position.bottom_left
        => position.bottom_right

f_size(string s) =>
    switch s
        "Tiny"   => size.tiny
        "Normal" => size.normal
        => size.small

f_presetList(string p) =>
    switch p
        "Momentum universe"    => "NVDA, AMD, AVGO, MU, DELL, TSLA, PLTR, MSFT, AAPL, GOOGL"
        "Mega-cap tech"        => "AAPL, MSFT, NVDA, GOOGL, AMZN, META, TSLA, AVGO, NFLX, ORCL, ADBE, CRM, AMD, QCOM, INTC, CSCO, IBM, V, MA, PYPL"
        "Semiconductors"       => "NVDA, AMD, AVGO, MU, QCOM, INTC, TSM, ASML, AMAT, LRCX, KLAC, MRVL, ARM, SMCI, ON, TXN, ADI, MCHP, NXPI, CRDO"
        "High beta / momentum" => "TSLA, PLTR, COIN, MSTR, HOOD, SOFI, RIVN, AFRM, UPST, SHOP, SNOW, NET, CRWD, DDOG, ROKU, RBLX, DKNG, APP, HIMS, CVNA"
        "Index ETFs + sectors" => "SPY, QQQ, IWM, DIA, SMH, XLK, XLF, XLE, XLV, XLI, XLY, XLP, XLU, XLB, XLRE, XLC, ARKK, TLT, GLD, USO"
        => custom

// Normalise the list: separators -> commas, upper case, no blanks / duplicates, max MAX_T.
f_parse(string raw) =>
    clean = str.upper(str.replace_all(str.replace_all(str.replace_all(raw, "\n", ","), ";", ","), " ", ","))
    out = array.new<string>()
    for p in str.split(clean, ",")
        if str.length(p) > 0 and not array.includes(out, p) and array.size(out) < MAX_T
            array.push(out, p)
    out

var array<string> syms = f_parse(f_presetList(preset))
n = array.size(syms)

// Runs on the EXTENDED-hours version of each symbol so premarket levels exist.
// Returns [close, dayVolume, priorClose, PDH, PDL, PMH, PML]; PDH/PDL/prior
// close come from the prior REGULAR session (09:30-16:00).
f_levels() =>
    var float pdh  = na
    var float pdl  = na
    var float pdc  = na
    var float rthH = na
    var float rthL = na
    var float rthC = na
    var float pmh  = na
    var float pml  = na
    var float dVol = 0.0
    newDay = nz(ta.change(dayofmonth)) != 0
    if newDay
        if not na(rthH)
            pdh := rthH
            pdl := rthL
            pdc := rthC
        rthH := na
        rthL := na
        rthC := na
        pmh  := na
        pml  := na
        dVol := 0.0
    dVol += nz(volume)
    if session.ispremarket
        pmh := na(pmh) ? high : math.max(pmh, high)
        pml := na(pml) ? low : math.min(pml, low)
    if session.ismarket
        rthH := na(rthH) ? high : math.max(rthH, high)
        rthL := na(rthL) ? low : math.min(rthL, low)
        rthC := close
    [close, dVol, pdc, pdh, pdl, pmh, pml]

// One dynamic request per ticker, every bar (values are read on the last bar).
cs  = array.new<float>(n, na)
vs  = array.new<float>(n, na)
pcs = array.new<float>(n, na)
hs  = array.new<float>(n, na)
ls  = array.new<float>(n, na)
mhs = array.new<float>(n, na)
mls = array.new<float>(n, na)
if n > 0
    for i = 0 to n - 1
        [c, v, pc, h, l, mh, ml] = request.security(ticker.modify(array.get(syms, i), session.extended), scrTf, f_levels(), ignore_invalid_symbol = true)
        array.set(cs, i, c)
        array.set(vs, i, v)
        array.set(pcs, i, pc)
        array.set(hs, i, h)
        array.set(ls, i, l)
        array.set(mhs, i, mh)
        array.set(mls, i, ml)

// Level column: a dot once price is through the level, otherwise a bar
// showing how far price has travelled across the range toward it.
f_bar(float frac) =>
    k = math.round(math.max(0.0, math.min(1.0, frac)) * 8)
    str.repeat("█", k) + str.repeat("░", 8 - k)

// side = 1 for a high-level column (PDH / PMH), -1 for a low-level column (PDL / PML).
f_brk(float c, float hi, float lo, int side) =>
    string txt = "–"
    if not na(c) and not na(hi) and not na(lo) and hi > lo
        if side == 1
            txt := c > hi ? "●" : c >= lo ? f_bar((c - lo) / (hi - lo)) : ""
        else
            txt := c < lo ? "●" : c <= hi ? f_bar((hi - c) / (hi - lo)) : ""
    txt

// 1 = above PDH and PMH, -1 = below PDL and PML, 0 = in between.
f_tr(float c, float hi, float lo, float pmHi, float pmLo) =>
    up = c > hi and (na(pmHi) or c > pmHi)
    dn = c < lo and (na(pmLo) or c < pmLo)
    up ? 1 : dn ? -1 : 0

f_vol(float v) =>
    na(v) ? "–" : v >= 1e9 ? str.tostring(v / 1e9, "#.##") + "B" : v >= 1e6 ? str.tostring(v / 1e6, "#.##") + "M" : v >= 1e3 ? str.tostring(v / 1e3, "#.##") + "K" : str.tostring(v, "#")

f_bare(string s) =>
    parts = str.split(s, ":")
    array.get(parts, array.size(parts) - 1)

var table scr = table.new(f_pos(scrPos), 9, MAX_T + 1, bgcolor = color.new(#000000, 0), border_color = color.new(#2A2E39, 0), border_width = 1, frame_color = color.new(#2A2E39, 0), frame_width = 1)
var array<int> prevTr = array.new<int>(MAX_T, 0)
var bool primed = false

if barstate.islast and n > 0
    pcts   = array.new<float>(n, na)
    trs    = array.new<int>(n, 0)
    scores = array.new<float>(n, 0.0)
    order0 = array.new<int>()
    for i = 0 to n - 1
        c  = array.get(cs, i)
        pc = array.get(pcs, i)
        pct = na(c) or na(pc) or pc == 0 ? na : (c - pc) / pc * 100
        tr = f_tr(c, array.get(hs, i), array.get(ls, i), array.get(mhs, i), array.get(mls, i))
        array.set(pcts, i, pct)
        array.set(trs, i, tr)
        array.set(scores, i, scrSort == "% change" ? nz(pct, -1e9) : tr * 1000.0 + nz(pct, -999))
        array.push(order0, i)

    // Alert when a ticker flips into a level trend (bar close only).
    if barstate.isconfirmed
        if primed and scrAlerts
            for i = 0 to n - 1
                tr = array.get(trs, i)
                if tr != array.get(prevTr, i) and tr != 0
                    alert("DTS screener: $" + f_bare(array.get(syms, i)) + (tr == 1 ? " ▲ above PDH + PMH" : " ▼ below PDL + PML") + " @ " + str.tostring(array.get(cs, i), "#.##"), alert.freq_once_per_bar_close)
        for i = 0 to n - 1
            array.set(prevTr, i, array.get(trs, i))
        primed := true

    ts = f_size(txtSize)
    idx = scrSort == "Input order" ? order0 : array.sort_indices(scores, order.descending)
    hdr = array.from("Ticker", "Price", "Volume", "% Chg", "PDH Break", "PDL Break", "PMH Break", "PML Break", "Trend")
    table.clear(scr, 0, 0, 8, MAX_T)
    for col = 0 to 8
        table.cell(scr, col, 0, array.get(hdr, col), text_color = color.white, bgcolor = color.new(#131722, 0), text_size = ts)
    for r = 0 to math.min(scrRows, n) - 1
        i  = array.get(idx, r)
        c  = array.get(cs, i)
        hi = array.get(hs, i)
        lo = array.get(ls, i)
        mh = array.get(mhs, i)
        ml = array.get(mls, i)
        pct = array.get(pcts, i)
        tr = array.get(trs, i)
        name = f_bare(array.get(syms, i))
        row = r + 1
        // Highlight the ticker that is on the chart right now.
        table.cell(scr, 0, row, "$" + name, text_color = color.white, bgcolor = name == syminfo.ticker ? color.new(C_SEL, 30) : na, text_size = ts, text_halign = text.align_left)
        table.cell(scr, 1, row, na(c) ? "invalid" : str.tostring(c, "#.##"), text_color = na(c) ? C_DIM : color.white, text_size = ts)
        table.cell(scr, 2, row, f_vol(array.get(vs, i)), text_color = color.white, text_size = ts)
        table.cell(scr, 3, row, na(pct) ? "–" : str.tostring(pct, "#.##") + "%", text_color = na(pct) ? C_DIM : pct >= 0 ? C_BULL : C_BEAR, text_size = ts)
        table.cell(scr, 4, row, f_brk(c, hi, lo, 1), text_color = C_BULL, text_size = ts)
        table.cell(scr, 5, row, f_brk(c, hi, lo, -1), text_color = C_BEAR, text_size = ts)
        table.cell(scr, 6, row, f_brk(c, mh, ml, 1), text_color = C_BULL, text_size = ts)
        table.cell(scr, 7, row, f_brk(c, mh, ml, -1), text_color = C_BEAR, text_size = ts)
        table.cell(scr, 8, row, tr == 1 ? "▲" : tr == -1 ? "▼" : "⚠", text_color = tr == 0 ? C_WARN : color.white, bgcolor = tr == 1 ? color.new(C_BULL, 10) : tr == -1 ? color.new(C_BEAR, 10) : na, text_size = ts)
